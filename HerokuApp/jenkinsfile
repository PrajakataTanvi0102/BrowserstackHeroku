pipeline {
    agent any

    environment {
        bs_username = credentials('bs_username')
        bs_token    = credentials('bs_token')
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Execute BrowserStack Tests') {
            steps {
                dir('HerokuApp') {
                    bat '"C:\\Program Files\\apache-maven-3.9.16\\bin\\mvn.cmd" clean test -DsuiteXmlFile=testng.xml'
                }
            }
        }
    }

    post {
        always {         
            dir('HerokuApp') {
                junit '**/target/surefire-reports/*.xml'
            }
        }
    }
}
